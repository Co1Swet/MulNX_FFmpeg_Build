config:x86:x86_64:generic:mingw32:gcc 16.1.0 (Rev6, Built by MSYS2 project):--prefix=/opt/ffmpeg-build/ffmpeg_install --enable-shared --disable-static --disable-doc --disable-programs --enable-avcodec --enable-avformat --enable-avutil --enable-swscale --enable-swresample --enable-avfilter --disable-everything --enable-avdevice --enable-indev=dshow --enable-d3d11va --enable-decoder='h264,flac,mp3,pcm_s16le' --enable-encoder='flac,libmp3lame,mp3_mf,pcm_s16le,libopenh264,h264_nvenc,h264_mf' --enable-hwaccel='h264_d3d11va,h264_d3d11va2' --enable-demuxer='mov,matroska,flac,mp3,wav' --enable-muxer='mp4,mov,matroska,flac,mp3,wav' --enable-parser='h264,flac,mpegaudio' --enable-protocol=file --disable-protocol=http --enable-filter='scale,format,trim,overlay,apad,atrim,asetpts,aresample,volume,amix,concat,anullsrc,crop,hflip,vflip,transpose,rotate,fps,setpts,setsar,setdar,fade,colorbalance,hue,unsharp,drawbox,tpad,xfade,hwupload,hwdownload,hwmap,scale_d3d11' --enable-libopenh264 --enable-libmp3lame --enable-ffnvcodec --enable-nvenc --enable-mediafoundation --extra-cflags='-include direct.h' --extra-libs='-lmpg123 -lshlwapi' --extra-ldflags=-static --pkg-config-flags=--static
